rules_version = '2';

// Emulator-only. Milestone 4 builds these Rules slice by slice (Milestone 4 Plan); until it is
// done nothing here may be deployed. Rules check authority, never game math or privacy
// (Architecture and Hosting, Security Rules scope).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The form two Aliases share when they count as the same (packages/storage/src/accounts.ts).
    function normalizedAlias(alias) {
      return alias.lower().replace('-', '_');
    }

    // A site administrator: an account whose administrator flag is set (seeded, never by the app).
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.admin == true;
    }

    // S1: an account holds its public Alias, approval status and administrator flag, and is
    // readable by anyone. A signed-in user creates only their own, as pending and not an
    // administrator, together with its Alias index entry. S2: a site administrator approves a
    // pending account, changing only its status and recording who approved it and when. Nobody
    // else changes an account, and nobody deletes one.
    match /accounts/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['alias', 'status', 'admin', 'createdAt'])
        && request.resource.data.alias is string
        && request.resource.data.alias.matches('[A-Za-z0-9_-]{4,32}')
        && request.resource.data.status == 'pending'
        && request.resource.data.admin == false
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/accounts-by-alias/$(normalizedAlias(request.resource.data.alias))).data.uid == uid;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt'])
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time;
    }

    // The Alias index makes Aliases unique: its id is the normalized Alias, and an entry is only
    // ever created, by the account that takes the Alias, in the same write as that account.
    match /accounts-by-alias/{key} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'alias'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alias is string
        && key == normalizedAlias(request.resource.data.alias)
        && !exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.alias == request.resource.data.alias;
    }

    // S3: records (characters, their tabs and history, items and other definitions). A record's
    // document id is its path with "/" written as "%2F" (packages/storage/src/firestore.ts), so
    // the scope and owner come from the id itself: account%2FVR_Lulu%2F… or campaign%2F<name>%2F….
    // Everyone may read every record, because privacy is screen-only. Writing needs an approved
    // account that is either the owner of the account path (by Alias) or a DM of the campaign.
    // Core records are written only by seeding. A save's `path` must name the same scope and
    // owner as its id.
    function isApproved() {
      return signedIn()
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.status == 'approved';
    }

    function ownsAlias(alias) {
      return get(/databases/$(database)/documents/accounts-by-alias/$(normalizedAlias(alias))).data.uid == request.auth.uid;
    }

    // A campaign's DMs are listed on /campaigns/{id}, where the id is the name's path segment in
    // lower case (packages/storage/src/campaigns.ts).
    function isCampaignDm(campaign) {
      return request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaign.lower())).data.dms;
    }

    function mayWriteRecord(id) {
      let parts = id.split('%2F');
      return parts.size() >= 3 && isApproved()
        && ((parts[0] == 'account' && ownsAlias(parts[1]))
          || (parts[0] == 'campaign' && isCampaignDm(parts[1])));
    }

    function pathMatchesId(id) {
      let parts = id.split('%2F');
      let path = request.resource.data.path.split('/');
      return path.size() >= 3 && path[0] == parts[0] && path[1] == parts[1];
    }

    match /records/{id} {
      allow read: if true;
      allow create, update: if mayWriteRecord(id)
        && request.resource.data.path is string
        && pathMatchesId(id);
      allow delete: if mayWriteRecord(id);
    }

    // S5: campaigns. A campaign holds its name and its DM and player lists, and is readable by
    // everyone. An approved account creates one with itself as the only DM. DMs change the lists
    // (approving, removing, granting and revoking DM); any member may remove only themselves;
    // a site administrator may restore DM. Every change keeps at least one DM. Nobody deletes a
    // campaign yet. The app adds players only from join requests.
    function campaignDoc(campaign) {
      return /databases/$(database)/documents/campaigns/$(campaign);
    }

    function isDmOf(campaign) {
      return signedIn() && request.auth.uid in get(campaignDoc(campaign)).data.dms;
    }

    function onlyListsChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dms', 'players'])
        && request.resource.data.dms is list && request.resource.data.players is list
        && request.resource.data.dms.size() >= 1;
    }

    function leavesOnlySelf() {
      let me = [request.auth.uid].toSet();
      return signedIn()
        && (request.auth.uid in resource.data.dms || request.auth.uid in resource.data.players)
        && request.resource.data.dms.toSet() == resource.data.dms.toSet().difference(me)
        && request.resource.data.players.toSet() == resource.data.players.toSet().difference(me);
    }

    function isCharacterPath(path) {
      return path.split('/').size() == 5 && path.split('/')[2] == 'Characters';
    }

    function proposalAllowed(campaign, p) {
      return (p.kind == 'entry' && p.target.split('/').size() >= 3
          && p.target.split('/')[2] != 'Characters')
        || (p.kind == 'edit' && isCharacterPath(p.target)
          && (ownsAlias(p.target.split('/')[3])
            || request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaign)/control/$(p.control)).data.delegates))
        || ((p.kind == 'delete' || p.kind == 'replace') && isCharacterPath(p.target)
          && ownsAlias(p.target.split('/')[3]));
    }

    match /campaigns/{campaign} {
      allow read: if true;
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['name', 'dms', 'players', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.dms == [request.auth.uid]
        && request.resource.data.players == []
        && request.resource.data.createdAt == request.time;
      allow update: if onlyListsChange()
        && ((isApproved() && request.auth.uid in resource.data.dms) || leavesOnlySelf() || isAdmin());

      // A join request: an approved account that is not yet a member, asking with the current
      // invite code. The person and the campaign's DMs may read and delete it.
      match /requests/{uid} {
        allow read, delete: if signedIn() && (request.auth.uid == uid || isDmOf(campaign));
        allow create: if isApproved() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 'at'])
          && request.resource.data.at == request.time
          && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.campaign == campaign
          && !(uid in get(campaignDoc(campaign)).data.dms)
          && !(uid in get(campaignDoc(campaign)).data.players);
      }

      // Milestone 5 S2: the table. `play/state` holds the game clock and the current scene's
      // record path; only DMs write it, and it is never deleted. The log is only ever added to:
      // any member posts text (`post`), and DMs also record what happens (scenes, the clock,
      // titles). Like everything else before privacy, both are readable by everyone.
      match /play/{part} {
        allow read: if true;
        allow create, update: if part == 'state' && isApproved() && isDmOf(campaign)
          && request.resource.data.keys().hasOnly(['clock', 'scene'])
          && request.resource.data.clock is number
          && request.resource.data.clock >= 0
          && request.resource.data.scene is string
          && request.resource.data.scene.split('/')[0] == 'campaign'
          && request.resource.data.scene.split('/')[1].lower() == campaign;
      }

      match /log/{entry} {
        allow read: if true;
        allow create: if isApproved()
          && (request.auth.uid in get(campaignDoc(campaign)).data.dms
            || request.auth.uid in get(campaignDoc(campaign)).data.players)
          && request.resource.data.keys().hasOnly(['kind', 'by', 'clock', 'text', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.clock is number
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.kind == 'post'
            || (request.resource.data.kind in ['scene', 'clock', 'title']
              && request.auth.uid in get(campaignDoc(campaign)).data.dms));
      }

      // S6: a member asks to add a copy of their own character. The copy goes under
      // Characters/<their Alias>/ in this campaign; the person and the DMs may read and delete
      // the request, and a DM approving it writes the records.
      match /insertions/{insertion} {
        allow read, delete: if signedIn()
          && (resource.data.by == request.auth.uid || isDmOf(campaign));
        allow create: if isApproved()
          && (request.auth.uid in get(campaignDoc(campaign)).data.dms
            || request.auth.uid in get(campaignDoc(campaign)).data.players)
          && request.resource.data.keys().hasOnly(['by', 'name', 'path', 'records', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.path is string
          && request.resource.data.path.split('/').size() == 5
          && request.resource.data.path.split('/')[0] == 'campaign'
          && request.resource.data.path.split('/')[1].lower() == campaign
          && request.resource.data.path.split('/')[2] == 'Characters'
          && ownsAlias(request.resource.data.path.split('/')[3]);
      }

      // S7: the DM review queue. A member proposes a change; the person and the DMs may read and
      // delete it, and a DM accepting it writes through the record Rule. An `edit` of a campaign
      // character comes from its owner or a current delegate (a revoked delegate is refused
      // here); `delete` and `replace` only from the owner; an `entry` (a new or imported library
      // entry) from any member, outside Characters. `control` names the character's control
      // document and must spell the same path as `target`.
      match /proposals/{proposal} {
        allow read, delete: if signedIn()
          && (resource.data.by == request.auth.uid || isDmOf(campaign));
        allow create: if isApproved()
          && (request.auth.uid in get(campaignDoc(campaign)).data.dms
            || request.auth.uid in get(campaignDoc(campaign)).data.players)
          && request.resource.data.keys().hasOnly(['kind', 'by', 'target', 'control', 'note', 'writes', 'deletes', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.target is string
          && request.resource.data.target.split('/')[0] == 'campaign'
          && request.resource.data.target.split('/')[1].lower() == campaign
          && request.resource.data.control.split('%2F') == request.resource.data.target.split('/')
          && proposalAllowed(campaign, request.resource.data);
      }

      // S6: delegated control. The character's owner (by the Alias in its path) chooses which
      // members may control it; the document id is the character's record document id.
      match /control/{character} {
        allow read: if true;
        allow write: if isApproved()
          && character.split('%2F').size() == 5
          && character.split('%2F')[1].lower() == campaign
          && ownsAlias(character.split('%2F')[3])
          && request.resource.data.keys().hasOnly(['delegates'])
          && request.resource.data.delegates is list
          && request.resource.data.delegates.toSet().difference(
            get(campaignDoc(campaign)).data.dms.toSet().union(get(campaignDoc(campaign)).data.players.toSet())
          ).size() == 0;
      }

      // The current invite code, for DMs only (written with the campaign when it is created).
      match /private/{document} {
        allow read: if isDmOf(campaign);
        allow write: if signedIn() && request.auth.uid in getAfter(campaignDoc(campaign)).data.dms;
      }
    }

    // Invite codes: whoever knows a code may look it up, but codes cannot be listed. A DM makes
    // and removes the codes of their campaign.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['campaign', 'name'])
        && request.auth.uid in getAfter(campaignDoc(request.resource.data.campaign)).data.dms;
      allow delete: if isDmOf(resource.data.campaign);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
