rules_version = '2';

// Emulator-only, Milestone 2: the app reads and writes records without sign-in. There is no
// real Firebase project. Milestone 4 replaces this with Rules that enforce authority (who may
// read and write); until then nothing here may be deployed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /records/{id} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
