{
  "name": "hearthtable",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hearthtable/web dev",
    "build": "pnpm --filter @hearthtable/web build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:emulator": "firebase emulators:exec --config firebase.test.json --only auth,firestore,storage \"vitest run --project emulator\"",
    "test:e2e": "firebase emulators:exec --config firebase.test.json --only auth,firestore,storage \"playwright test\"",
    "emulators": "node scripts/emulators.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "peek": "tsx scripts/peek.ts",
    "seed": "tsx scripts/seed.ts",
    "start": "node scripts/start.mjs",
    "srd:spells": "tsx scripts/srd-spells.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hearthtable/content": "workspace:*",
    "@hearthtable/engine": "workspace:*",
    "@hearthtable/kernel": "workspace:*",
    "@hearthtable/ruleset-hearthtable-vanilla-plus": "workspace:*",
    "@hearthtable/storage": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
