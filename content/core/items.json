      "tags": ["weapon"],
      "weapon": {
        "category": "simple",
        "kind": "ranged",
        "damage": {
          "dice": "1d6",
          "type": "Piercing"
        },
        "range": "80/320",
        "ammunition": "arrow",
        "properties": ["Ammunition", "Two-Handed"],
        "mastery": "Vex"
      },
      "container": {
        "slots": [
          {
            "id": "nocked",
            "label": "Nocked arrow",
            "x": 0,
            "y": 0
          }
        ],
        "accepts": ["arrow"],
        "contentsAddWeight": true
      },
      "attacks": [
        {
          "id": "fire",
          "name": "Fire",
          "rounds": 1
