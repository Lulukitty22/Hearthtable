  {
    "id": "core/Items/Potion_of_Healing",
    "kind": "item",
    "moduleId": "containers",
    "schemaVersion": 1,
    "origin": {
      "scope": "core"
    },
    "source": {
      "status": "published",
      "edition": "2024",
      "reference": "Player's Handbook (2024) equipment, checked 2026-10-22"
    },
    "revision": 0,
    "updatedAt": "2026-10-22T20:30:00.000Z",
    "data": {
      "name": "Potion of Healing",
      "weight": 0.5,
      "costGp": 50,
      "tags": ["potion"],
      "use": {
        "budget": "bonus",
        "healing": "2d4+2",
        "consumed": true,
        "targets": "self or a creature within 5 feet"
      },
      "srd": {
        "version": "5.2.1",
        "credit": "This work includes material from the System Reference Document 5.2.1 (SRD 5.2.1) by Wizards of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the Creative Commons Attribution 4.0 International License, available at https://creativecommons.org/licenses/by/4.0/legalcode.",
        "text": [
          "This potion is a magic item. As a Bonus Action, you can drink it or administer it to another creature within 5 feet of yourself. The creature that drinks the magical red fluid in this vial regains 2d4 + 2 Hit Points.",
          "Whatever its potency, the potion's red liquid glimmers when agitated."
        ]
      }
    }
  },
